# Optional password recovery; without SMTP, login still works but email reset cannot send.
# Set these variables in the server's environment, not inside public Python app source.
AI_APP_SERVER_SMTP_HOST=smtp.example.com
AI_APP_SERVER_SMTP_PORT=587
AI_APP_SERVER_SMTP_FROM="AI App Server <no-reply@example.com>"
AI_APP_SERVER_SMTP_USER=your-smtp-username
AI_APP_SERVER_SMTP_PASSWORD=your-smtp-app-password
# For implicit TLS on port 465, set AI_APP_SERVER_SMTP_SSL=1 instead.
# For production, set the externally reachable HTTPS base URL:
# AI_APP_SERVER_PUBLIC_ORIGIN=https://apps.example.com
