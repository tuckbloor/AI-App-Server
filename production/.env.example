# Copy to production/.env (never commit it). Set a REAL domain pointing to this server.
APP_DOMAIN=ai.example.org
PUBLIC_ORIGIN=https://ai.example.org
## Application users are stored in SQLite. Create via Admin > App Users or CLI setup-app-user.


# Set to 1 only after reviewing app/mcp_tools.py (trusted code, not sandboxed).
AI_APP_SERVER_MCP_TOOLS_APPROVED=0

# Leave 0 unless you trust the code and have independently checked its digest.
AI_APP_SERVER_MCP_TOOLS_SHA256=
